{
  "name": "ration",
  "version": "1.0.0",
  "private": true,
  "description": "Brave extension: daily opens per site, a time limit per open, streaks, and screen time stats.",
  "type": "module",
  "scripts": {
    "test": "node --test test/core.test.js test/stats.test.js",
    "e2e": "node test/e2e.mjs",
    "e2e:dist": "node scripts/package.mjs && node test/e2e.mjs --dist",
    "package": "npm test && node scripts/package.mjs",
    "store-assets": "node scripts/store-assets.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^24.0.0"
  }
}
